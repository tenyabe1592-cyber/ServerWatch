# Copy to /etc/serverwatch/serverwatch.env and chmod 600.
SERVERWATCH_DB_PATH=/var/lib/serverwatch/serverwatch.db
SERVERWATCH_USERNAME=admin
SERVERWATCH_PASSWORD_HASH=replace-with-output-from-python-m-serverwatch-hash-password
SERVERWATCH_INTERVAL_SECONDS=60
SERVERWATCH_STALE_AFTER_SECONDS=180
SERVERWATCH_CPU_THRESHOLD=90
SERVERWATCH_MEMORY_THRESHOLD=90
SERVERWATCH_DISK_THRESHOLD=90
SERVERWATCH_SERVICES='["bouncer.service","tailscaled.service","ssh.service"]'
SERVERWATCH_ENDPOINTS='["http://127.0.0.1:8501/"]'
SERVERWATCH_ROOT_PATH=/serverwatch

# The sole M1 notification channel is SMTP. Leave blank only during setup.
SERVERWATCH_SMTP_HOST=
SERVERWATCH_SMTP_PORT=587
SERVERWATCH_SMTP_USERNAME=
SERVERWATCH_SMTP_PASSWORD=
SERVERWATCH_SMTP_FROM=
SERVERWATCH_SMTP_TO=
SERVERWATCH_SMTP_STARTTLS=true
